# ==============================================================================
# SUTRA Canonical Environment Variables Configuration
# Copy this file to .env or .env.local; NEVER commit real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development  # "development" | "staging" | "production"
API_V1_STR=/api/v1
PROJECT_NAME="SUTRA"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# CORS configuration (comma-separated list of origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. Database & Supabase Persistence
# ------------------------------------------------------------------------------
# DEVELOPMENT (Local offline or SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./sutra_dev.db
# SYNC_DATABASE_URL=sqlite:///./sutra_dev.db

# PRODUCTION / STAGING (Supabase PostgreSQL Connection Pooler):
# Direct connection (IPv6 only on AWS free tier, port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Supabase PgBouncer / Supavisor Connection Pooler (IPv4 compatible):
# Transaction Pooler (Port 6543) - Recommended for serverless/API backends:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Synchronous connection for Alembic migrations (Session Pooler Port 5432):
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:54322/postgres

# Connection Pooling & Engine Hardening (Supabase Pooler Compatible)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
DATABASE_STATEMENT_CACHE_SIZE=0  # Critical: Must be 0 for asyncpg with transaction pooler

# ------------------------------------------------------------------------------
# 3. Supabase Auth & Server-Side JWT Verification
# ------------------------------------------------------------------------------
# Supabase Project Credentials (from Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=replace_with_local_or_sandbox_anon_key

# SERVER-SIDE ONLY: NEVER expose to browser, client, or logs (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Supabase Auth JWT Secret (Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret_from_dashboard
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=supabase

# ------------------------------------------------------------------------------
# 4. Machine Learning (sutra_ml) Subsystem
# ------------------------------------------------------------------------------
ML_INFERENCE_ENABLED=false
ML_MODEL_ARTIFACT_PATH=ml/artifacts/models
ML_MODEL_VERSION=1.0.0
ML_MODEL_NAME=logistic_regression_baseline
ML_DEFAULT_THRESHOLD=0.46
ML_CUTOFF_DAYS=30
ML_FEATURES_CONFIG_PATH=ml/configs/features.yaml

# ------------------------------------------------------------------------------
# 5. Asynchronous Outbox Worker & Deadlines
# ------------------------------------------------------------------------------
SUTRA_WORKER_INTERVAL_SECONDS=15
SUTRA_WORKER_BATCH_SIZE=50
SUTRA_OUTBOX_MAX_ATTEMPTS=5
SUTRA_OUTBOX_BACKOFF_BASE_SECONDS=30

# ------------------------------------------------------------------------------
# 6. Privacy, Safeguards & Aggregation (ADR-003 / ADR-004)
# ------------------------------------------------------------------------------
SUTRA_MIN_AGGREGATE_CELL=5

# ------------------------------------------------------------------------------
# 7. Controlled Demo Clock (Local Testing Only)
# ------------------------------------------------------------------------------
SUTRA_DEMO_MODE=true
SUTRA_DEMO_CLOCK_START=2026-10-12T09:00:00Z

# ------------------------------------------------------------------------------
# 8. Bounded AI Orchestration Layer (ADR-006 / Phase 6)
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=mock  # "mock" | "openai" | "gemini"
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10.0
AI_MAX_RETRIES=2
# OPENAI_API_KEY=replace_with_server_only_key
# GEMINI_API_KEY=replace_with_server_only_key

# ------------------------------------------------------------------------------
# 9. Next.js Frontend Client (Decoupled, Browser-Safe Only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_or_sandbox_anon_key

# ------------------------------------------------------------------------------
# 10. Base Sepolia Blockchain & Document Anchoring (Chain ID 84532)
# ------------------------------------------------------------------------------
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# SERVER-SIDE ONLY: Never expose deployment or relayer private key to frontend or git
# BASE_SEPOLIA_PRIVATE_KEY=your_testnet_private_key_without_0x
# BASE_SEPOLIA_CONTRACT_ADDRESS=0x_deployed_contract_address_on_base_sepolia
ANCHOR_MODE=simulated  # "simulated" (default offline/mock) or "onchain" (real Base Sepolia broadcast)
DOCUMENTS_STORAGE_DIR=storage/documents

# ------------------------------------------------------------------------------
# 11. SBI Digital Rupee (e₹) CBDC Integration Boundary (Simulated)
# ------------------------------------------------------------------------------
CBDC_ENABLED=true
CBDC_PROVIDER=simulated  # "simulated" | "sbi_sandbox"
# CBDC_MERCHANT_ID=your_sbi_merchant_id
# CBDC_SANDBOX_URL=https://sandbox.sbi.co.in/cbdc/v1

